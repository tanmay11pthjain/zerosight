# Local dev needs none of these: memory storage + in-process Postgres are used by default.
STORAGE_TYPE=s3
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
DATABASE_URL=
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
RECEIPT_SIGNING_KEY=
TURNSTILE_SECRET=
ADMIN_TOKEN=
MAX_ROOM_BYTES=2147483648
MAX_STORED_BYTES=4294967296
MONTHLY_EGRESS_LIMIT_GB=90
